{
  "name": "parley",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @parley/server",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "dev:web": "npm run dev -w @parley/web",
    "seed": "npm run seed -w @parley/server"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
