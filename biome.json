{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": { "includes": ["**", "!**/node_modules", "!**/dist", "!**/coverage"] },
  "formatter": { "indentStyle": "space", "lineWidth": 110 },
  "linter": {
    "rules": {
      "recommended": true,
